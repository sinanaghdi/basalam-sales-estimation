# Datasets and experiment outputs must not be committed
data/*
!data/.gitkeep
outputs/*

# Python environments and generated files
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Secrets and local configuration
.env
.env.*
!.env.example

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
